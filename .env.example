# 复制本文件为 .env 并填写真实值：cp .env.example .env
# .env 已被 .gitignore 排除，切勿提交到仓库

# ---- 模型：DeepSeek 官方 Anthropic 兼容端点 ----
AGENT_BASE_URL=https://api.deepseek.com/anthropic
AGENT_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_MODEL=deepseek-flash

# ---- 持久化：PostgreSQL 连接串（LangGraph checkpointer）----
# 形如 postgresql://<user>:<password>@<host>:<port>/<dbname>
AGENT_PG_DSN=postgresql://postgres:your_password@127.0.0.1:5432/langgraph_db

# ---- 可选：Tavily 联网检索（留空则自动禁用 web_search）----
TAVILY_API_KEY=
